# ==============================================================================
# Q-Sight Command Center - Environment Variables Template (Live Mode)
# Phase 0 Baseline Stabilization Sprint: Verified Staging Baseline v1.1
# ==============================================================================
# IMPORTANT: Copy to .env.local or .env manually.
# NEVER commit secrets, passwords, or production credentials!
# ==============================================================================

# Server Configurations
API_PORT=4000
WS_PORT=4001
WEB_PORT=3000
NODE_ENV=development

# Database Setup (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qsight?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qsight

# Map & 3D Visualization Providers
# Get Cesium Ion Token from: https://ion.cesium.com
CESIUM_ION_TOKEN="your_cesium_ion_token_here"
# Get Google Maps API Key for Photorealistic 3D Tiles from: https://developers.google.com/maps
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Security & Audit Log settings
AUDIT_LOGGING_ENABLED=true
SECURITY_STRICT_FEED_VERIFICATION=true
JWT_SECRET="your_secure_jwt_secret_here"

# Ingestor Controls
MOCK_INGESTOR_WRITE_TO_DB=false

# ==============================================================================
# V0.6 WebSocket Real-Time Telemetry Configuration
# SCOPE: Non-camera mechanical/geospatial telemetry only.
# ==============================================================================

# Enable/disable WebSocket real-time endpoint on backend
WS_ENABLED=true

# Heartbeat interval in milliseconds (default: 25000ms = 25s)
WS_HEARTBEAT_MS=25000

# Mock broadcaster interval in milliseconds (default: 7000ms = 7s)
# This controls how often aircraft delta updates are emitted to subscribed clients.
WS_MOCK_BROADCAST_MS=7000

# Frontend WebSocket connection URL
# IMPORTANT: Do NOT use a production auth token or API key in this URL.
# Development-only: role is passed as query param. Production requires JWT auth.
VITE_WS_URL=ws://localhost:4000/ws/realtime

# Enable/disable real-time WebSocket on the frontend (true = enabled)
VITE_REALTIME_ENABLED=true

# ==============================================================================
# V0.7 Live Open-Data Ingestion Configuration
# Live Profile: Active polling for public feeds.
# ==============================================================================
LIVE_INGESTION_ENABLED=true
AIRCRAFT_LIVE_ENABLED=true
SATELLITE_LIVE_ENABLED=true
SEISMIC_LIVE_ENABLED=true

AIRCRAFT_SOURCE_URL="https://opensky-network.org/api/states/all"
AIRCRAFT_SOURCE_USERNAME=""
AIRCRAFT_SOURCE_PASSWORD=""

SATELLITE_TLE_SOURCE_URL="https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle"
SATELLITE_GROUPS="stations"

SEISMIC_SOURCE_URL="https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson"
SEISMIC_MIN_MAGNITUDE=2.5

# Conservative polling notes:
# OpenSky: 120000ms (120 seconds minimum)
# Seismic: 300000ms (5 minutes)
# Satellite: 86400000ms (24 hours)
INGESTION_INTERVAL_AIRCRAFT_MS=120000
INGESTION_INTERVAL_SATELLITE_MS=86400000
INGESTION_INTERVAL_SEISMIC_MS=300000

INGESTION_REQUEST_TIMEOUT_MS=10000
INGESTION_MAX_RECORDS_PER_RUN=500

LIVE_INGESTOR_WRITE_TO_DB=true

# ==============================================================================
# Scheduler Configuration
# ==============================================================================
SCHEDULER_ENABLED=true
SEISMIC_POLL_INTERVAL_MS=300000
AIRCRAFT_POLL_INTERVAL_MS=120000
SATELLITE_POLL_INTERVAL_MS=86400000
